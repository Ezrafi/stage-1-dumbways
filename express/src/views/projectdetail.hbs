<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Project Detail</title>

    <!-- CSS Utama -->
    <link rel="stylesheet" href="/css/detail.css">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/css/bootstrap.min.css">
</head>

<body>

<!-- ====================== NAVBAR ====================== -->
    <nav class="navbar navbar-expand-lg bg-dark navbar-dark">
        <!-- Logo -->
        <a class="navbar-brand" href="#">
            <img style="width: 30px;" src="/home.png" alt="Home Icon">
        </a>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler" type="button" data-toggle="collapse"
                data-target="#navbarSupportedContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Items -->
        <div class="collapse navbar-collapse" id="navbarSupportedContent">

            <ul class="navbar-nav mr-auto">
                <li class="nav-item active">
                    <a class="nav-link" href="/home">Home</a>
                </li>

                <!-- My Project -->
                <li class="nav-item">
                    <a class="nav-link" href="/projectdetail">My Project</a>
                </li>
            </ul>

        </div>
    </nav>

    <div class="container mt-4">

    <div class="form-wrapper">

        <h1>ADD MY PROJECT</h1>

        <form 
            class="form" 
            id="project-form"
            method="POST" 
            action="/submit-project" 
            enctype="multipart/form-data" 
        >

            <label for="input-title">Project Name</label>
            <input type="text" id="input-title" name="project_name" placeholder="Enter project name" required>

            <div class="row">
                <div class="form-group">
                    <label for="input-start">Start Date</label>
                    <input type="date" id="input-start" name="start_date" required>
                </div>
                <div class="form-group">
                    <label for="input-end">End Date</label>
                    <input type="date" id="input-end" name="end_date" required>
                </div>
            </div>

            <label for="input-desc">Description</label>
            <textarea rows="4" id="input-desc" name="description"></textarea>

            <label>Technologies</label>
            <div class="tech-grid" id="input-tech">
                <label><input type="checkbox" name="technologies" value="Node Js"> Node Js</label>
                <label><input type="checkbox" name="technologies" value="Next Js"> Next Js</label>
                <label><input type="checkbox" name="technologies" value="React Js"> React Js</label>
                <label><input type="checkbox" name="technologies" value="TypeScript"> TypeScript</label>
            </div>

            <label for="input-image">Upload Image</label>
            <div class="upload-box">
                <input type="file" id="input-image" name="image" accept="image/*" required>
            </div>

            <button type="submit" class="submit-btn" id="btn-submit">Submit Project</button>

        </form>
    </div>
</div>

    <!-- Bootstrap JS -->
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.3/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/js/bootstrap.min.js"></script>

</body>
</html>


