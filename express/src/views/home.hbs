<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portofolio Atha Ezrafi</title>

    <link rel="stylesheet" href="/css/style.css">

    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
    crossorigin="anonymous" referrerpolicy="no-referrer"/>

    <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/css/bootstrap.min.css"
    crossorigin="anonymous">

    <link href="https://fonts.cdnfonts.com/css/akira-expanded" rel="stylesheet">
</head>

<body>

                        {{!-- Navbar --}}

    <nav class="navbar navbar-expand-lg bg-dark navbar-dark">
    <a class="navbar-brand" href="/home">
        <img style="width: 30px;" src="/home.png" alt="Home Icon">
    </a>

    <button class="navbar-toggler" type="button" data-toggle="collapse"
            data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">

        <ul class="navbar-nav mr-auto">
            <li class="nav-item active">
                <a class="nav-link" href="/home">Home</a>
            </li>

            {{#if isAuthenticated}}
                <li class="nav-item">
                    <a class="nav-link" href="/projectdetail">My Project</a>
                </li>
            {{/if}}
        </ul>

        <ul class="navbar-nav ml-auto">
            {{#if isAuthenticated}}
                <li class="nav-item">
                    <span class="nav-link text-white">
                        Halo, <b>{{userEmail}}</b>
                    </span>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link btn btn-danger text-white ml-2" href="/logout">Logout</a>
                </li>

            {{else}}
                <li class="nav-item">
                    <a class="nav-link" href="/register">Register</a>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link btn btn-success text-white ml-2" href="/login">Login</a>
                </li>
            {{/if}}
        </ul>

    </div>
</nav>


    <div class="container content-wrapper">

        <div class="left-content">
            <h1>Welcome to My Website</h1>

            <p>
                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore
                et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut
                aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse
                cillum dolore eu fugiat nulla pariatur.
            </p>

            <div class="social-icons">
                <a href="https://www.instagram.com/" target="_blank">
                    <i class="fa-brands fa-instagram"></i>
                </a>

                <a href="https://github.com/Ezrafi" target="_blank">
                    <i class="fa-brands fa-github"></i>
                </a>
            </div>
        </div>

        <div class="card2">
            <img src="/cat.jpg">
            <div class="info">
                <h2><b>Atha Ezrafi</b></h2>
                <p>Fullstack Developer</p>
            </div>
        </div>

    </div>
    <h1 class="project-title">MY PROJECT</h1>

    <div class="project-grid" id="project-grid">

        {{#each projects}}
        
        <div class="card" id="project-card-{{this.id}}">
            <img src="/uploads/{{this.image}}" class="card-img" style="cursor:pointer;">

            <div class="card-body">
                
                <h3>
                    <a class="nav-link" href="/project/{{this.id}}" style="text-decoration:none; color:inherit;">
                        {{this.project_name}}
                    </a>
                </h3>

                <p class="duration">Durasi: {{this.start_date_formatted}} s/d {{this.end_date_formatted}}</p>
                
                <p class="desc">
                    {{this.description}}
                </p>

                <div class="icons" id="project-icons-{{this.id}}">
                    {{#each this.technologiesArray}}
                        <span class="tech-badge">{{this}}</span>
                    {{/each}}
                    </div>

                <div class="card-buttons">
                    <a href="/edit-project/{{this.id}}" class="edit btn btn-sm btn-warning">edit</a>
                    
                    <form action="/project/delete/{{this.id}}" method="POST" style="display:inline;">
                        <button type="submit" class="delete btn btn-sm btn-danger">delete</button>
                    </form>
                </div>
            </div>
        </div>

        {{/each}}
        {{#unless projects}}
        <div class="col-12 text-center mt-5">
            <p class="text-muted">Belum ada proyek yang ditambahkan. <a href="/projectdetail">Tambahkan proyek pertama Anda di sini!</a></p>
        </div>
        {{/unless}}

    </div>


    <script src="/src/assets/js/index.js"></script>
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.3/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/js/bootstrap.min.js"></script>

</body>
</html>