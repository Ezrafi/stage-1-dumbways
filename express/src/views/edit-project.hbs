<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Project: {{project.project_name}}</title>

    <link rel="stylesheet" href="/css/detail.css">
    <link rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/css/bootstrap.min.css">
</head>

<body>

<nav class="navbar navbar-expand-lg bg-dark navbar-dark">
        <a class="navbar-brand" href="#">
            <img style="width: 30px;" src="/home.png" alt="Home Icon">
        </a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mr-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/home">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/projectdetail">My Project</a>
                </li>
            </ul>
        </div>
    </nav>

    <div class="container mt-4">

        <div class="form-wrapper">

            <h1>EDIT PROJECT</h1>

            <form 
                class="form" 
                id="edit-project-form"
                method="POST" 
                
                action="/update-project/{{project.id}}" 
                
                enctype="multipart/form-data" 
            >
                <label for="input-title">Project Name</label>
                <input type="text" id="input-title" name="project_name" 
                       value="{{project.project_name}}" placeholder="Enter project name" required>

                <div class="row">
                    <div class="form-group">
                        <label for="input-start">Start Date</label>
                        <input type="date" id="input-start" name="start_date" 
                               value="{{project.start_date_formatted}}" required>
                    </div>
                    <div class="form-group">
                        <label for="input-end">End Date</label>
                        <input type="date" id="input-end" name="end_date" 
                               value="{{project.end_date_formatted}}" required>
                    </div>
                </div>

                <label for="input-desc">Description</label>
                <textarea rows="4" id="input-desc" name="description">{{project.description}}</textarea>

                <label>Technologies</label>
                <div class="tech-grid" id="input-tech">
                    {{! Helper untuk mengecek apakah teknologi ini termasuk dalam daftar proyek }}
                    
                    {{#with project}}
                        <label>
                            <input type="checkbox" name="technologies" value="Node Js" 
                                   {{#if (isIncluded technologiesArray "Node Js")}}checked{{/if}}> Node Js
                        </label>
                        <label>
                            <input type="checkbox" name="technologies" value="Next Js" 
                                   {{#if (isIncluded technologiesArray "Next Js")}}checked{{/if}}> Next Js
                        </label>
                        <label>
                            <input type="checkbox" name="technologies" value="React Js" 
                                   {{#if (isIncluded technologiesArray "React Js")}}checked{{/if}}> React Js
                        </label>
                        <label>
                            <input type="checkbox" name="technologies" value="TypeScript" 
                                   {{#if (isIncluded technologiesArray "TypeScript")}}checked{{/if}}> TypeScript
                        </label>
                    {{/with}}
                </div>
                
                <label>Current Image</label>
                <img src="/uploads/{{project.image_filename}}" style="max-width: 100px; display: block; margin-bottom: 15px;">

                <label for="input-image">Change Image (Optional)</label>
                <div class="upload-box">
                    <input type="file" id="input-image" name="image" accept="image/*">
                </div>

                <button type="submit" class="submit-btn" id="btn-submit">Save Changes</button>

            </form>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.14.3/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.1.3/dist/js/bootstrap.min.js"></script>

</body>
</html>